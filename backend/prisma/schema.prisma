// SMS Platform - Prisma Schema
// Database: PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// USER MANAGEMENT
// ===========================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  role         UserRole @default(USER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  auditLogs    AuditLog[]

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
}

// ===========================================
// CLIENT MANAGEMENT
// ===========================================

model Client {
  id           String   @id @default(cuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String   @unique  // E.164 format
  email        String?
  birthday     DateTime?
  // taxFiledDate: when the client filed their tax return (used to target
  // "previous tax year active" campaigns via the Campaign.audience feature).
  // Populated by the future CSV import; until then, this is null for all
  // clients and the PREV_YEAR_ACTIVE audience resolver will return an empty set.
  taxFiledDate DateTime? @map("tax_filed_date")
  notes        String?
  optedOut     Boolean  @default(false) @map("opted_out")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  consents         Consent[]
  outboundMessages Message[]     @relation("OutboundMessages")
  inboundMessages  InboundMessage[]

  @@index([phone])
  @@index([optedOut])
  @@index([birthday])
  @@index([taxFiledDate])
  @@map("clients")
}

// ===========================================
// CONSENT TRACKING (A2P Compliance)
// ===========================================

model Consent {
  id          String       @id @default(cuid())
  clientId    String       @map("client_id")
  consentType ConsentType  @map("consent_type")
  source      String       // web, sms, verbal, etc.
  timestamp   DateTime     @default(now())

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([consentType])
  @@map("consents")
}

enum ConsentType {
  SMS
  MARKETING
  APPOINTMENT_REMINDER
  BIRTHDAY_MESSAGE
}

// ===========================================
// MESSAGE TEMPLATES
// ===========================================

model Template {
  id           String           @id @default(cuid())
  name         String           @unique
  category     TemplateCategory
  content      String           // Supports {{variables}}
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relations
  campaigns Campaign[]

  @@map("templates")
}

enum TemplateCategory {
  ONBOARDING
  MARKETING
  NOTIFICATION
  TRANSACTIONAL
  ALERT
}

// ===========================================
// CAMPAIGNS
// ===========================================

model Campaign {
  id               String         @id @default(cuid())
  name             String
  description      String?
  templateId       String?        @map("template_id")
  status           CampaignStatus @default(DRAFT)
  scheduleTime     DateTime?      @map("schedule_time")
  recurrence       RecurrenceType? @default(NONE)
  // Audience targeting — resolved at /send time, not at create time:
  //   ALL               → all opted-in clients (current behavior)
  //   PREV_YEAR_ACTIVE  → opted-in clients with taxFiledDate in the prior calendar year
  //   MANUAL            → opted-in clients from manualRecipientIds (opted-out entries are dropped)
  audience         AudienceType   @default(ALL)
  manualRecipientIds String[]     @map("manual_recipient_ids")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([status])
  @@index([scheduleTime])
  @@index([audience])
  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum AudienceType {
  ALL
  PREV_YEAR_ACTIVE
  MANUAL
}

// ===========================================
// MESSAGES
// ===========================================

model Message {
  id           String        @id @default(cuid())
  clientId     String        @map("client_id")
  campaignId   String?       @map("campaign_id")
  twilioSid    String?       @map("twilio_sid")
  content      String
  status       MessageStatus @default(PENDING)
  retryCount   Int           @default(0) @map("retry_count")
  errorMessage String?       @map("error_message")
  scheduledAt  DateTime?     @map("scheduled_at")
  sentAt       DateTime?     @map("sent_at")
  deliveredAt  DateTime?     @map("delivered_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relations
  client   Client   @relation("OutboundMessages", fields: [clientId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([campaignId])
  @@index([status])
  @@index([twilioSid])
  @@index([scheduledAt])
  @@map("messages")
}

enum MessageStatus {
  PENDING    // Created but not yet queued
  QUEUED     // In the job queue
  SENT       // Sent to Twilio
  DELIVERED  // Confirmed by Twilio
  FAILED     // Failed after retries
}

// ===========================================
// INBOUND MESSAGES (Replies from clients)
// ===========================================

model InboundMessage {
  id         String   @id @default(cuid())
  clientId   String   @map("client_id")
  twilioSid  String?  @map("twilio_sid")
  body       String
  receivedAt DateTime @default(now()) @map("received_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([twilioSid]) // Prevent duplicate webhook delivery
  @@index([clientId])
  @@map("inbound_messages")
}

// ===========================================
// WEBHOOK EVENTS (Idempotency / Audit)
// ===========================================

model WebhookEvent {
  id          String   @id @default(cuid())
  eventType   String   @map("event_type")
  payloadHash String   @map("payload_hash") // SHA hash for deduplication
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([payloadHash])
  @@map("webhook_events")
}

// ===========================================
// AUDIT LOGS
// ===========================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  clientId  String?  @map("client_id")
  actor     String   // User email or "SYSTEM"
  action    String   // user_login, client_created, message_sent, etc.
  details   Json?    // Additional context
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clientId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}