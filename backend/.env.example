# ===========================================
# SMS Platform - Environment Variables Template
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!
# ===========================================

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="postgresql://user:password@host:5432/sms_platform?schema=public"

# ===========================================
# REDIS (Upstash or self-hosted)
# ===========================================
REDIS_URL="redis://user:password@host:6379"

# ===========================================
# AUTHENTICATION
# ===========================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ===========================================
# FRONTEND (Backend needs to know CORS origins)
# ===========================================
FRONTEND_URL="http://localhost:3000"

# ===========================================
# TWILIO
# ===========================================
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token-here"
TWILIO_API_KEY_SID="SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_API_KEY_SECRET="your-api-key-secret-here"
TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_WEBHOOK_AUTH_TOKEN="your-webhook-auth-token-here"

# ===========================================
# NODE ENVIRONMENT
# ===========================================
NODE_ENV="development"