// ===========================================
// SMS Platform - Prisma Database Schema
// ===========================================
// Based on BUILD_BRIEF.md data models
// Run: npx prisma generate && npx prisma migrate dev
// ===========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// USER & AUTHENTICATION
// ===========================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  auditLogs AuditLog[]

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
}

// ===========================================
// CLIENTS
// ===========================================

model Client {
  id            String    @id @default(cuid())
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String    @unique // E.164 format: +1234567890
  email         String?
  birthday      DateTime?
  notes         String?
  optedOut      Boolean   @default(false) @map("opted_out")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  consents          Consent[]
  outboundMessages  Message[]     @relation("ClientOutbound")
  inboundMessages   InboundMessage[]
  auditLogs         AuditLog[]

  @@index([phone])
  @@index([optedOut])
  @@map("clients")
}

// ===========================================
// CONSENT TRACKING (A2P Compliance)
// ===========================================

model Consent {
  id          String       @id @default(cuid())
  clientId    String       @map("client_id")
  consentType ConsentType
  source      String       // web, phone, written, etc.
  timestamp   DateTime     @default(now())
  createdAt   DateTime     @default(now()) @map("created_at")

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("consents")
}

enum ConsentType {
  SMS
  EMAIL
  MARKETING
  APPOINTMENT_REMINDER
}

// ===========================================
// MESSAGE TEMPLATES
// ===========================================

model Template {
  id        String          @id @default(cuid())
  name      String
  category  TemplateCategory
  content   String          // Supports variables like {{firstName}}, {{date}}
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  // Relations
  campaigns Campaign[]

  @@map("templates")
}

enum TemplateCategory {
  APPOINTMENT_REMINDER
  BIRTHDAY
  HOLIDAY
  PROMOTIONAL
  TAX_SEASON
  GENERAL
}

// ===========================================
// CAMPAIGNS
// ===========================================

model Campaign {
  id           String          @id @default(cuid())
  name         String
  description  String?
  templateId   String?         @map("template_id")
  status       CampaignStatus  @default(DRAFT)
  scheduleTime DateTime?       @map("schedule_time")
  recurrence   RecurrenceType? // null = one-time
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  // Relations
  template   Template?   @relation(fields: [templateId], references: [id])
  messages   Message[]

  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

enum RecurrenceType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// ===========================================
// MESSAGES (Outbound)
// ===========================================

model Message {
  id              String         @id @default(cuid())
  clientId        String         @map("client_id")
  campaignId      String?        @map("campaign_id")
  twilioSid       String?        @unique @map("twilio_sid")
  content         String
  status          MessageStatus  @default(PENDING)
  retryCount      Int            @default(0) @map("retry_count")
  scheduledAt     DateTime?      @map("scheduled_at")
  sentAt          DateTime?      @map("sent_at")
  deliveredAt     DateTime?      @map("delivered_at")
  errorMessage    String?        @map("error_message")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  client   Client   @relation("ClientOutbound", fields: [clientId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([clientId])
  @@index([campaignId])
  @@index([status])
  @@index([scheduledAt])
  @@map("messages")
}

enum MessageStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNDELIVERED
}

// ===========================================
// INBOUND MESSAGES (Replies)
// ===========================================

model InboundMessage {
  id         String   @id @default(cuid())
  clientId   String?  @map("client_id")
  twilioSid  String   @unique @map("twilio_sid") // Prevent duplicate processing
  fromNumber String   @map("from_number")
  body       String
  receivedAt DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at") // NULL = not processed yet

  // Relations
  client Client? @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([fromNumber])
  @@map("inbound_messages")
}

// ===========================================
// WEBHOOK EVENTS (Audit & Idempotency)
// ===========================================

model WebhookEvent {
  id          String   @id @default(cuid())
  eventType   String   @map("event_type")
  payloadHash String   @map("payload_hash") // SHA-256 of raw payload for deduplication
  rawPayload  Json     @map("raw_payload")
  processed   Boolean  @default(false)
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([payloadHash])
  @@index([eventType])
  @@index([processed])
  @@map("webhook_events")
}

// ===========================================
// AUDIT LOGS (Security & Compliance)
// ===========================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  clientId  String?  @map("client_id")
  actor     String   // user email, system, api
  action    String   // create, update, delete, send, opt-out, etc.
  details   Json?   // Additional context
  ipAddress String?  @map("ip_address")
  timestamp DateTime @default(now())

  // Relations
  user   User?   @relation(fields: [userId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([actor])
  @@index([timestamp])
  @@map("audit_logs")
}